# LLM 配置（勿在代码中硬编码模型，由此处配置）
# mock：无 API Key 时使用内置示例（本地开发）
# openai / compatible：OpenAI 或兼容端点
LLM_PROVIDER=mock

# 开发页脚展示（可选，与 LLM_* 保持一致）
NEXT_PUBLIC_LLM_PROVIDER=mock
NEXT_PUBLIC_LLM_MODEL=mock

# 智谱 GLM-5.1（推荐，OpenAI 兼容）：
# LLM_PROVIDER=compatible
# LLM_API_KEY=你的智谱开放平台 API Key
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-5.1
#
# 其他 OpenAI 兼容服务（DeepSeek 等）：
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=your-model-id

# Supabase（用户认证与跨设备同步）
# 可公开的项目 URL 与 Publishable Key；不要填写 service_role / secret key。
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Webhook 回写套餐需要 service_role（仅服务端，切勿加 NEXT_PUBLIC_）
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_SUPABASE_SERVICE_ROLE_KEY

# Waffo Pancake 支付（测试环境）。密钥只放环境变量，不要提交到仓库。
WAFFO_ENVIRONMENT=test
WAFFO_MERCHANT_ID=MER_5YWJjmynhustUIjWzijhvI
WAFFO_STORE_ID=STO_5ZieQt10JNwx0m5jqtjYHY
WAFFO_PRIVATE_KEY=REPLACE_ME_WAFFO_PRIVATE_KEY_PEM
# 若 PEM 不好放进环境变量，改用整段 Base64（二选一即可）
# WAFFO_PRIVATE_KEY_BASE64=REPLACE_ME_WAFFO_PRIVATE_KEY_BASE64
WAFFO_PRO_MONTHLY_PRODUCT_ID=REPLACE_ME_PROD_MONTHLY
WAFFO_PRO_YEARLY_PRODUCT_ID=REPLACE_ME_PROD_YEARLY
NEXT_PUBLIC_APP_URL=https://lomivex.top
